# Database Configuration
POSTGRES_USER=visarun_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=visarun_db

# Application Configuration
NODE_ENV=production
PORT=3001
JWT_SECRET=your_jwt_secret_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
BACKEND_URL=https://your-domain.com
LOG_LEVEL=info

# Frontend Configuration
VITE_API_URL=https://your-domain.com

# S3 Storage Configuration (Yandex Cloud)
S3_ACCESS_KEY_ID=YCAJE4Zx...
S3_SECRET_ACCESS_KEY=YCOJx5r3K8n...
S3_BUCKET_NAME=your-visarun-documents
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net

# Optional: KMS Key for encryption (recommended for sensitive data)
S3_KMS_KEY_ID=your-kms-key-id

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to git
# 4. Make sure .env is in your .gitignore file
