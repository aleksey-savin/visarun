# Environment Configuration for Visarun
# Copy this file to .env and configure for your environment

# Environment Mode (development or production)
NODE_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=visarun

# For production, use these instead:
# POSTGRES_USER=visarun_prod
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DB=visarun_production

# JWT Secret - Use a strong secret for production
JWT_SECRET=dev-jwt-secret-change-for-production

# Session Secret (optional)
SESSION_SECRET=dev-session-secret-change-for-production

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# Backend Configuration
PORT=3001

# API URLs - Development defaults
BACKEND_URL=http://backend:3001
VITE_API_URL=http://localhost:3001

# For production, use these instead:
# BACKEND_URL=https://yourdomain.com
# VITE_API_URL=https://yourdomain.com

# Logging
LOG_LEVEL=debug
