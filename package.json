{
  "name": "visarun",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "back": "pnpm --filter @visarun/backend",
    "web": "pnpm --filter @visarun/webapp",
    "dev": "pnpm -r --parallel dev",
    "types": "concurrently 'pnpm back types' 'pnpm web types'",
    "lint": "pnpm -r --parallel lint",
    "format": "pnpm -r --parallel format",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
