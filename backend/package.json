{
  "name": "@visarun/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/app.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "eslint . --ext .ts,.js",
    "check-format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "types": "tsc --noEmit --project tsconfig.json",
    "pmd": "prisma migrate dev",
    "pgc": "prisma generate",
    "prisma:seed": "tsx src/utils/seed.ts",
    "prisma:seed-prod": "node dist/src/utils/seed.js",
    "prepare": "",
    "build": "prisma generate && rm -rf dist && swc src -d dist --extensions '.ts,.tsx' && cp -r prisma dist/ && echo '{\"type\":\"module\"}' > dist/package.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.1",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@swc/cli": "^0.7.3",
    "@swc/core": "^1.11.21",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/heic-convert": "^2.1.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@trpc/server": "^11.1.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "prisma": "^6.6.0",
    "zod": "^3.24.3"
  }
}
