generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  isSystem    Boolean              @default(false)
  isActive    Boolean              @default(true)
  createdById String?              @default(uuid())
  updatedById String?              @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  createdBy   User?                @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?                @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  category    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model User {
  id                       String                     @id @default(uuid())
  email                    String?                    @unique
  firstName                String
  middleName               String?
  lastName                 String
  role                     UserRole?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  password                 String
  mustChangePassword       Boolean                    @default(false)
  isActive                 Boolean                    @default(true)
  phoneNumber              String?                    @unique
  AuditLog                 AuditLog[]
  Client                   Client[]
  ClientDiscountAssignment ClientDiscountAssignment[]
  reviewedDocuments        ClientDocument[]           @relation("ReviewedDocuments")
  ClientDocument           ClientDocument[]
  ClientRequirement        ClientRequirement[]
  exchangeRates            ExchangeRate[]
  Order                    Order[]
  refreshTokens            RefreshToken[]
  RequirementDocument      RequirementDocument[]
  rolesCreated             Role[]                     @relation("RoleCreatedBy")
  rolesUpdated             Role[]                     @relation("RoleUpdatedBy")
  contactMethods           UserContactMethod[]
  roleAssignments          UserRoleAssignment[]
  OrderPayment             OrderPayment[]
  currencyExchangesCreated CurrencyExchange[]         @relation("CurrencyExchangeCreatedBy")
  currencyExchangesUpdated CurrencyExchange[]         @relation("CurrencyExchangeUpdatedBy")
  transactionsCreated      Transaction[]              @relation("TransactionCreatedBy")
  transactionsUpdated      Transaction[]              @relation("TransactionUpdatedBy")
}

model Client {
  id                        String                     @id @default(uuid())
  userId                    String?
  citizenshipId             String?
  prevViolations            Boolean                    @default(false)
  prevViolationsDesc        String?
  isOutsideTheCountry       Boolean                    @default(false)
  isOutsideTheCountryAt     DateTime?
  firstName                 String?
  lastName                  String?
  isPrimary                 Boolean                    @default(false)
  passportExpirationDate    DateTime?
  preConfirmPassportIsValid Boolean                    @default(false)
  citizenship               Citizenship?               @relation(fields: [citizenshipId], references: [id])
  user                      User?                      @relation(fields: [userId], references: [id])
  bankingDetails            BankingDetails?
  ClientDiscountAssignment  ClientDiscountAssignment[]
  documents                 ClientDocument[]
  requirements              ClientRequirement[]
  ClientVisa                ClientVisa[]
  clients                   OrderClient[]
  OrderItem                 OrderItem[]
  VisarunPassenger          VisarunPassenger[]
  transactionsSent          Transaction[]

  @@index([userId])
  @@index([citizenshipId])
}

model ContactMethod {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  icon        String?
  assignments UserContactMethod[]
}

model UserContactMethod {
  id              String         @id @default(uuid())
  userId          String
  contactMethodId String?
  value           String?
  url             String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  method          ContactMethod? @relation(fields: [contactMethodId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@unique([userId, contactMethodId])
  @@index([userId])
  @@index([contactMethodId])
}

model Citizenship {
  id                     String                     @id @default(uuid())
  name                   String                     @unique
  favourite              Boolean                    @default(false)
  abbreviation           String                     @unique
  emoji                  String
  blacklisted            Blacklisted[]
  Client                 Client[]
  RequirementCitizenship RequirementCitizenship[]
  surcharges             VisaCitizenshipSurcharge[]
  visaFree               VisaFree[]
}

model Country {
  id                       String                     @id @default(uuid())
  name                     String                     @unique
  eVisaAvailable           Boolean                    @default(false)
  multivisaAvailable       Boolean                    @default(false)
  favourite                Boolean                    @default(false)
  multivisaIsGlobal        Boolean                    @default(false)
  multivisaGlobalExtraCost Float?
  blacklisted              Blacklisted[]
  cities                   City[]
  ClientVisa               ClientVisa[]
  Requirement              Requirement[]
  VisaApplication          VisaApplication[]
  surcharges               VisaCitizenshipSurcharge[]
  visaFree                 VisaFree[]
  VisaType                 VisaType[]
}

model VisaFree {
  citizenshipId String
  countryId     String
  stampDuration Int
  citizenship   Citizenship @relation(fields: [citizenshipId], references: [id])
  country       Country     @relation(fields: [countryId], references: [id])

  @@id([citizenshipId, countryId])
}

model Blacklisted {
  citizenshipId String
  countryId     String
  citizenship   Citizenship @relation(fields: [citizenshipId], references: [id])
  country       Country     @relation(fields: [countryId], references: [id])

  @@id([citizenshipId, countryId])
}

model VisaCitizenshipSurcharge {
  id              String                             @id @default(uuid())
  citizenshipId   String
  surchargeAmount Float
  note            String?
  countryId       String
  isGlobal        Boolean                            @default(false)
  citizenship     Citizenship                        @relation(fields: [citizenshipId], references: [id])
  country         Country                            @relation(fields: [countryId], references: [id])
  visaTypes       VisaCitizenshipSurchargeVisaType[]
}

model VisaCitizenshipSurchargeVisaType {
  id          String                   @id @default(uuid())
  surchargeId String
  visaTypeId  String
  surcharge   VisaCitizenshipSurcharge @relation(fields: [surchargeId], references: [id], onDelete: Cascade)
  visaType    VisaType                 @relation(fields: [visaTypeId], references: [id])

  @@unique([surchargeId, visaTypeId])
}

model ExchangeRate {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  rubToVnd   Float
  vndToRub   Float
  usdtToVnd  Float
  vndToUsdt  Float
  usdtToRub  Float
  rubToUsdt  Float
  userId     String
  currencyId String?
  Currency   Currency? @relation(fields: [currencyId], references: [id])
  createdBy  User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TelegramChannel {
  id                String                @id @default(uuid())
  createdAt         DateTime              @default(now())
  chatId            String                @unique
  chatTitle         String
  chatUsername      String
  chatType          String
  fromId            String
  fromIsBot         Boolean
  fromFirstName     String
  fromLastName      String
  fromUsername      String
  status            TelegramChannelStatus @default(active)
  updatedAt         DateTime              @updatedAt
  messageTemplateId String?
  messageTemplate   MessageTemplate?      @relation(fields: [messageTemplateId], references: [id])
}

model MessageTemplate {
  id               String            @id @default(uuid())
  title            String
  body             String
  telegramChannels TelegramChannel[]
}

model Order {
  id                 String               @id @default(uuid())
  userId             String
  createdAt          DateTime             @default(now())
  status             OrderStatus          @default(draft)
  comment            String?
  updatedAt          DateTime             @default(now()) @updatedAt
  user               User                 @relation(fields: [userId], references: [id])
  clients            OrderClient[]
  items              OrderItem[]
  orderPayments      OrderPayment[]
  OrderPickupAddress OrderPickupAddress[]
}

model OrderClient {
  id       String @id @default(uuid())
  orderId  String
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, clientId])
  @@index([orderId])
  @@index([clientId])
}

model OrderItem {
  id                  String               @id @default(uuid())
  orderId             String
  clientId            String
  serviceType         ServiceType
  serviceTypeId       String?
  discountAppliedType DiscountAppliedType?
  discountRuleId      String?
  discountAmount      Float
  discountComment     String?
  note                String?
  basePrice           Float
  finalPrice          Float
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  client              Client               @relation(fields: [clientId], references: [id])
  discountRule        ClientDiscountRule?  @relation(fields: [discountRuleId], references: [id])
  order               Order                @relation(fields: [orderId], references: [id])
  VisaApplication     VisaApplication[]
  VisarunPassenger    VisarunPassenger[]
  currencyExchange    CurrencyExchange?

  @@index([orderId])
  @@index([clientId])
  @@index([discountRuleId])
}

model ClientDiscountRule {
  id                   String                     @id @default(uuid())
  name                 String
  discountType         DiscountType
  discountValue        Float
  appliesToService     AppliesToService
  appliesAutomatically Boolean
  validFrom            DateTime
  validTo              DateTime
  minOrders            Int
  isActive             Boolean
  note                 String?
  assignments          ClientDiscountAssignment[]
  OrderItem            OrderItem[]
}

model ClientDiscountAssignment {
  id               String             @id @default(uuid())
  clientId         String
  ruleId           String
  assignedByUserId String
  assignedAt       DateTime
  note             String?
  assignedBy       User               @relation(fields: [assignedByUserId], references: [id])
  client           Client             @relation(fields: [clientId], references: [id])
  rule             ClientDiscountRule @relation(fields: [ruleId], references: [id])

  @@index([clientId])
  @@index([ruleId])
  @@index([assignedByUserId])
}

model VisaType {
  id                    String                             @id @default(uuid())
  name                  String
  serviceCost           Float
  countryId             String
  isMultientry          Boolean
  multientryExtraCost   Float?
  processingMode        ProcessingMode
  processingUnit        ProcessingUnit
  processingValueFixed  Int?
  processingValueMin    Int?
  processingValueMax    Int?
  submissionDayIncluded Boolean
  favourite             Boolean                            @default(false)
  clientVisas           ClientVisa[]
  Requirement           Requirement[]
  RequirementVisaType   RequirementVisaType[]
  visaApplications      VisaApplication[]
  surcharges            VisaCitizenshipSurchargeVisaType[]
  country               Country                            @relation(fields: [countryId], references: [id])
}

model VisaApplication {
  id                      String                @id @default(uuid())
  orderItemId             String
  applicationCode         String?
  submittedByAgent        Boolean
  countryId               String
  visaTypeId              String?
  note                    String?
  revisedActivationDate   DateTime? // check for deleting
  cancelReason            String?
  denialReason            String?
  statusNote              String?
  status                  VisaApplicationStatus
  plannedCountryEntryDate DateTime?
  plannedCountryExitDate  DateTime?
  plannedCompletionDate   DateTime?
  stampUntilDate          DateTime?
  stampIsRecieved         Boolean               @default(false)
  clientIsInTheCountry    Boolean               @default(false)
  isMultientry            Boolean               @default(false)
  isArchived              Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now())
  clientVisas             ClientVisa[]
  country                 Country               @relation(fields: [countryId], references: [id])
  orderItem               OrderItem             @relation(fields: [orderItemId], references: [id])
  visaType                VisaType?             @relation(fields: [visaTypeId], references: [id])
}

model ClientVisa {
  id                String          @id @default(uuid())
  clientId          String
  countryId         String
  visaTypeId        String
  visaApplicationId String
  validFrom         DateTime
  validTo           DateTime
  notifiedExpiry    Boolean
  client            Client          @relation(fields: [clientId], references: [id])
  country           Country         @relation(fields: [countryId], references: [id])
  visaApplication   VisaApplication @relation(fields: [visaApplicationId], references: [id])
  visaType          VisaType        @relation(fields: [visaTypeId], references: [id])

  @@index([clientId])
  @@index([countryId])
  @@index([visaTypeId])
  @@index([visaApplicationId])
}

model Requirement {
  id                       String                      @id @default(uuid())
  serviceType              ServiceType
  inputType                RequirementInputType
  operator                 RequirementOperator?
  thresholdNumber          Float?
  thresholdDate            DateTime?
  thresholdText            String?
  thresholdBool            Boolean?
  checkpointValue          String?
  title                    String
  description              String?
  appliesToAllCitizenships Boolean                     @default(false)
  sampleUrl                String?
  applicableServices       ServiceEntityType[]
  visaTypeId               String?
  applicationScope         RequirementApplicationScope @default(specific)
  countryId                String?
  isOptional               Boolean                     @default(false)
  clientDocuments          ClientDocument[]
  clientRequirements       ClientRequirement?
  country                  Country?                    @relation(fields: [countryId], references: [id])
  VisaType                 VisaType?                   @relation(fields: [visaTypeId], references: [id])
  citizenships             RequirementCitizenship[]
  documents                RequirementDocument[]
  visaTypeLinks            RequirementVisaType[]
  routeLinks               RequirementVisarunRoute[]

  @@index([serviceType])
  @@index([applicationScope])
  @@index([countryId])
}

model RequirementCitizenship {
  id            String      @id @default(uuid())
  requirementId String
  citizenshipId String
  citizenship   Citizenship @relation(fields: [citizenshipId], references: [id])
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@index([requirementId])
  @@index([citizenshipId])
}

model RequirementDocument {
  id            String      @id @default(uuid())
  requirementId String
  fileUrl       String
  uploadedAt    DateTime
  uploadedById  String
  comment       String?
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])

  @@index([requirementId])
  @@index([uploadedById])
}

model RequirementVisaType {
  requirementId String
  visaTypeId    String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  visaType      VisaType    @relation(fields: [visaTypeId], references: [id])

  @@id([requirementId, visaTypeId])
  @@index([visaTypeId])
}

model RequirementVisarunRoute {
  requirementId String
  routeId       String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@id([requirementId, routeId])
  @@index([routeId])
}

model ClientDocument {
  id            String       @id @default(uuid())
  clientId      String
  requirementId String?
  fileName      String
  originalName  String
  fileUrl       String
  fileType      String
  fileSize      Int
  uploadedAt    DateTime     @default(now())
  uploadedById  String
  isValid       Boolean      @default(true)
  expiresAt     DateTime?
  tags          String[]
  comment       String?
  reviewedAt    DateTime?
  reviewedById  String?
  client        Client       @relation(fields: [clientId], references: [id])
  requirement   Requirement? @relation(fields: [requirementId], references: [id])
  reviewedBy    User?        @relation("ReviewedDocuments", fields: [reviewedById], references: [id])
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([requirementId])
}

model ClientRequirement {
  id              String      @id @default(uuid())
  clientId        String
  requirementId   String      @unique
  textValue       String?
  dateValue       DateTime?
  booleanValue    Boolean?
  checkpointValue String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  comment         String?
  client          Client      @relation(fields: [clientId], references: [id])
  requirement     Requirement @relation(fields: [requirementId], references: [id])
  reviewedBy      User?       @relation(fields: [reviewedById], references: [id])

  @@index([requirementId])
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String
  entityType  String
  entityId    String
  action      AuditAction
  performedAt DateTime
  diff        Json
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Currency {
  id                    String             @id @default(uuid())
  name                  String             @unique
  exchangeRates         ExchangeRate[]
  orderPayments         OrderPayment[]
  currencyExchangesFrom CurrencyExchange[] @relation("FromCurrency")
  currencyExchangesTo   CurrencyExchange[] @relation("ToCurrency")

  @@map("currencies")
}

model OrderPayment {
  id                            String        @id @default(uuid())
  orderId                       String
  amount                        Decimal
  amountInSelectedCurrency      Decimal
  currencyId                    String
  paidAt                        DateTime
  paymentMethod                 PaymentMethod
  confirmPaymentWithoutDocument Boolean       @default(false)
  documentUrl                   String?
  acceptedById                  String?
  acceptedByUser                User?         @relation(fields: [acceptedById], references: [id])
  currency                      Currency      @relation(fields: [currencyId], references: [id])
  order                         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([currencyId])
  @@index([acceptedById])
}

// CURRENCY EXCHANGE

model CurrencyExchange {
  id                           String                 @id @default(uuid())
  position                     Int
  exchangeRate                 Decimal
  amount                       Decimal
  amountInSelectedCurrencyFrom Decimal
  amountInSelectedCurrencyTo   Decimal
  status                       CurrencyExchangeStatus @default(draft)
  cancelReason                 String?
  canceledByClient             Boolean?
  deadline                     DateTime?
  minTransactionAmount         Decimal?
  orderItemId                  String                 @unique
  fromCurrencyId               String
  toCurrencyId                 String
  createdById                  String
  updatedById                  String
  orderItem                    OrderItem              @relation(fields: [orderItemId], references: [id])
  fromCurrency                 Currency               @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency                   Currency               @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  transactions                 Transaction[]
  createdBy                    User                   @relation("CurrencyExchangeCreatedBy", fields: [createdById], references: [id])
  updatedBy                    User                   @relation("CurrencyExchangeUpdatedBy", fields: [updatedById], references: [id])
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @default(now()) @updatedAt
}

model Transaction {
  id                       String            @id @default(uuid())
  amount                   Decimal
  amountInSelectedCurrency Decimal
  customExchangeRate       Boolean
  checkUrl                 String?
  status                   TransactionStatus @default(draft)
  currencyExchangeId       String
  senderId                 String
  createdById              String
  updatedById              String
  currencyExchange         CurrencyExchange  @relation(fields: [currencyExchangeId], references: [id])
  sender                   Client            @relation(fields: [senderId], references: [id])
  createdBy                User              @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  updatedBy                User              @relation("TransactionUpdatedBy", fields: [updatedById], references: [id])
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now()) @updatedAt
}

model BankingDetails {
  id          String   @id @default(uuid())
  content     String?
  documentUrl String?
  clientId    String   @unique
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// VISARUN

model TransportType {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  icon        String?
  transports  Transport[]
}

model Transport {
  id                    String                      @id @default(uuid())
  transportTypeId       String
  name                  String                      @unique
  description           String?
  seatCount             Int?
  transportType         TransportType               @relation(fields: [transportTypeId], references: [id])
  seatDistribution      TransportSeatDistribution[]
  VisarunRouteTransport VisarunRouteTransport[]
  VisarunTripTransport  VisarunTripTransport[]
}

model SeatClass {
  id                    String                      @id @default(uuid())
  name                  String                      @unique
  description           String?
  icon                  String?
  VisarunSeatPrice      VisarunSeatPrice[]
  transportDistribution TransportSeatDistribution[]
}

model VisarunSeatPrice {
  id          String       @id @default(uuid())
  seatClassId String
  price       Decimal      @default(0)
  routeId     String
  route       VisarunRoute @relation(fields: [routeId], references: [id])
  seatClass   SeatClass    @relation(fields: [seatClassId], references: [id])
}

model TransportSeatDistribution {
  id          String   @id @default(uuid())
  transportId String
  seatClassId String
  seatCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transport Transport @relation(fields: [transportId], references: [id], onDelete: Cascade)
  seatClass SeatClass @relation(fields: [seatClassId], references: [id], onDelete: Cascade)

  @@unique([transportId, seatClassId])
}

model VisarunRoute {
  id   String  @id @default(uuid())
  name String?

  stamp Boolean @default(false)
  visa  Boolean @default(false)

  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  routeStops      VisarunRouteStop[]
  prices          VisarunSeatPrice[]
  transports      VisarunRouteTransport[]
  VisarunSchedule VisarunSchedule[]
  VisarunTrip     VisarunTrip[]
}

model VisarunRouteTransport {
  id          String   @id @default(uuid())
  routeId     String
  transportId String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  route     VisarunRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  transport Transport    @relation(fields: [transportId], references: [id])

  @@unique([routeId, transportId])
  @@index([routeId])
  @@index([transportId])
}

model VisarunRouteStop {
  id              String        @id @default(uuid())
  routeId         String
  cityId          String
  stopOrder       Int
  stopType        RouteStopType
  pickupMode      PickupMode
  arrivalTime     String?
  departureTime   String?
  arrivalNextDay  Boolean       @default(false)
  waitingDuration Int?

  route            VisarunRoute                @relation(fields: [routeId], references: [id], onDelete: Cascade)
  city             City                        @relation("RouteStops", fields: [cityId], references: [id])
  pickupLocations  VisarunStopPickupLocation[]
  VisarunPassenger VisarunPassenger[]

  @@unique([routeId, stopOrder])
  @@unique([routeId, cityId])
}

model PickupLocation {
  id          String  @id @default(uuid())
  cityId      String
  name        String
  address     String
  landmark    String?
  coordinates String?
  isActive    Boolean @default(true)

  city       City                        @relation("PickupLocations", fields: [cityId], references: [id])
  routeStops VisarunStopPickupLocation[]
}

model VisarunSchedule {
  id          String  @id @default(uuid())
  routeId     String
  name        String?
  description String?

  daysOfWeek Json

  departureTime String

  validFrom DateTime
  validTo   DateTime?

  autoGeneratePeriodMonths Int @default(12)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  route VisarunRoute  @relation(fields: [routeId], references: [id])
  trips VisarunTrip[]

  @@index([routeId])
  @@index([validFrom, validTo])
}

model VisarunTrip {
  id         String  @id @default(uuid())
  scheduleId String?
  routeId    String

  departureDateTime DateTime

  status TripStatus @default(scheduled)

  notes        String?
  cancelReason String?

  isFromSchedule Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule VisarunSchedule? @relation(fields: [scheduleId], references: [id])
  route    VisarunRoute     @relation(fields: [routeId], references: [id])

  // Связи
  transports VisarunTripTransport[]
  passengers VisarunPassenger[]

  @@index([scheduleId])
  @@index([routeId])
  @@index([departureDateTime])
  @@index([status])
}

model VisarunTripTransport {
  id          String @id @default(uuid())
  tripId      String
  transportId String

  driverName    String?
  driverPhone   String?
  vehicleNumber String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  trip      VisarunTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transport Transport   @relation(fields: [transportId], references: [id])

  passengers VisarunPassenger[]

  @@index([tripId])
  @@index([transportId])
}

model VisarunPassenger {
  id              String  @id @default(uuid())
  tripId          String
  tripTransportId String?
  clientId        String
  orderItemId     String

  serviceType VisarunServiceType

  // Место и посадка
  seatNumber    String?
  seatClass     String?
  pickupAddress String?
  pickupTime    String?
  routeStopId   String?

  // Статус пассажира
  status PassengerStatus @default(confirmed)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip          VisarunTrip           @relation(fields: [tripId], references: [id])
  tripTransport VisarunTripTransport? @relation(fields: [tripTransportId], references: [id])
  client        Client                @relation(fields: [clientId], references: [id])
  orderItem     OrderItem             @relation(fields: [orderItemId], references: [id])
  pickupStop    VisarunRouteStop?     @relation(fields: [routeStopId], references: [id])

  @@index([tripId])
  @@index([tripTransportId])
  @@index([clientId])
  @@index([orderItemId])
}

model OrderPickupAddress {
  id          String  @id @default(uuid())
  orderId     String
  routeStopId String
  address     String
  landmark    String?
  pickupTime  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model VisarunStopPickupLocation {
  id               String  @id @default(uuid())
  routeStopId      String
  pickupLocationId String
  pickupTime       String?

  routeStop      VisarunRouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  pickupLocation PickupLocation   @relation(fields: [pickupLocationId], references: [id])

  @@unique([routeStopId, pickupLocationId])
}

model City {
  id              String             @id @default(uuid())
  name            String
  countryId       String
  isActive        Boolean            @default(true)
  country         Country            @relation(fields: [countryId], references: [id])
  routeStops      VisarunRouteStop[] @relation("RouteStops")
  pickupLocations PickupLocation[]   @relation("PickupLocations")
}

