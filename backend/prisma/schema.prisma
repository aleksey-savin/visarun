generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum UserRole {
  client
  manager
  admin
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  isSystem    Boolean              @default(false)
  isActive    Boolean              @default(true)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  createdBy   User?   @relation("RoleCreatedBy", fields: [createdById], references: [id])
  createdById String? @default(uuid())
  updatedBy   User?   @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  updatedById String? @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  category    String?
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String? // если нужно хранить, кто назначил

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
}

model User {
  // Основные поля
  id         String  @id @default(uuid())
  email      String  @unique
  firstName  String
  middleName String?
  lastName   String
  password   String
  mustChangePassword Boolean @default(false)

  // Старая жёстко зашитая роль (оставляем до финальной чистки)
  role UserRole?

  // Таймстемпы
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Связи на другие модели
  exchangeRates ExchangeRate[] // курсы обмена, если есть
  refreshTokens RefreshToken[] // токены обновления

  // Назначенные роли
  roleAssignments UserRoleAssignment[]

  // Обратные реляции для полей createdBy/updatedBy
  // для модели Role
  rolesCreated Role[] @relation("RoleCreatedBy")
  rolesUpdated Role[] @relation("RoleUpdatedBy")
}

model ExchangeRate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // RUB ↔ VND
  rubToVnd Float // Сколько VND дают за 1 RUB
  vndToRub Float // Сколько RUB дают за 1000 VND

  // USDT ↔ VND
  usdtToVnd Float // Сколько VND дают за 1 USDT
  vndToUsdt Float // Сколько VND берут за 1 USDT

  // USDT ↔ RUB
  usdtToRub Float // Сколько RUB дают за 1 USDT
  rubToUsdt Float // Сколько RUB берут за 1 USDT

  // Связь с пользователем, создавшим запись
  createdBy User   @relation(fields: [userId], references: [id])
  userId    String

  // Индекс для улучшения производительности при поиске по userId
  @@index([userId])
}

enum TelegramChannelStatus {
  active
  blocked
  kicked
  insufficient_permissions
}

model TelegramChannel {
  id                String                @id @default(uuid())
  chatId            String                @unique
  chatTitle         String
  chatUsername      String
  chatType          String
  fromId            String
  fromIsBot         Boolean
  fromFirstName     String
  fromLastName      String
  fromUsername      String
  status            TelegramChannelStatus @default(active)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  messageTemplateId String?
  messageTemplate   MessageTemplate?      @relation(fields: [messageTemplateId], references: [id])
}

model MessageTemplate {
  id               String            @id @default(uuid())
  title            String
  body             String
  telegramChannels TelegramChannel[]
}
