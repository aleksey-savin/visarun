generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum UserRole {
  client
  manager
  admin
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  firstName     String
  middleName    String?
  lastName      String
  password      String
  role          UserRole       @default(client)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  exchangeRates ExchangeRate[] // Связь с курсами валют
  refreshTokens RefreshToken[]
}

model ExchangeRate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // RUB ↔ VND
  rubToVnd Float // Сколько VND дают за 1 RUB
  vndToRub Float // Сколько RUB дают за 1000 VND

  // USDT ↔ VND
  usdtToVnd Float // Сколько VND дают за 1 USDT
  vndToUsdt Float // Сколько VND берут за 1 USDT

  // USDT ↔ RUB
  usdtToRub Float // Сколько RUB дают за 1 USDT
  rubToUsdt Float // Сколько RUB берут за 1 USDT

  // Связь с пользователем, создавшим запись
  createdBy User   @relation(fields: [userId], references: [id])
  userId    String

  // Индекс для улучшения производительности при поиске по userId
  @@index([userId])
}

enum TelegramChannelStatus {
  active
  blocked
  kicked
  insufficient_permissions
}

model TelegramChannel {
  id                String                @id @default(uuid())
  chatId            String                @unique
  chatTitle         String
  chatUsername      String
  chatType          String
  fromId            String
  fromIsBot         Boolean
  fromFirstName     String
  fromLastName      String
  fromUsername      String
  status            TelegramChannelStatus @default(active)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  messageTemplateId String?
  messageTemplate   MessageTemplate?      @relation(fields: [messageTemplateId], references: [id])
}

model MessageTemplate {
  id               String            @id @default(uuid())
  title            String
  body             String
  telegramChannels TelegramChannel[]
}
