generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  isSystem    Boolean              @default(false)
  isActive    Boolean              @default(true)
  createdById String?              @default(uuid())
  updatedById String?              @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  createdBy   User?                @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?                @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  category    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model User {
  id                       String                     @id @default(uuid())
  email                    String                     @unique
  firstName                String
  middleName               String?
  lastName                 String
  role                     UserRole?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  password                 String
  mustChangePassword       Boolean                    @default(false)
  exchangeRates            ExchangeRate[]
  refreshTokens            RefreshToken[]
  rolesCreated             Role[]                     @relation("RoleCreatedBy")
  rolesUpdated             Role[]                     @relation("RoleUpdatedBy")
  contactMethods           UserContactMethod[]
  roleAssignments          UserRoleAssignment[]
  Client                   Client[]
  Order                    Order[]
  ClientDiscountAssignment ClientDiscountAssignment[]
}

model Client {
  id                       String                     @id @default(uuid())
  userId                   String?
  user                     User?                      @relation(fields: [userId], references: [id])
  firstName                String
  lastName                 String
  citizenshipId            String?
  citizenship              Citizenship?               @relation(fields: [citizenshipId], references: [id])
  prevViolations           Boolean                    @default(false)
  prevViolationsDesc       String?
  isOutsideTheCountry      Boolean                    @default(false)
  isOutsideTheCountryAt    DateTime?
  passports                ClientPassport[]
  OrderItem                OrderItem[]
  ClientDiscountAssignment ClientDiscountAssignment[]

  @@index([userId])
  @@index([citizenshipId])
}

model ClientPassport {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  expirationDate DateTime
  scanPath       String

  @@index([clientId])
}

model ContactMethod {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  assignments UserContactMethod[]
}

model UserContactMethod {
  id              String        @id @default(uuid())
  userId          String
  contactMethodId String
  value           String
  url             String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  method          ContactMethod @relation(fields: [contactMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, contactMethodId])
  @@index([userId])
  @@index([contactMethodId])
}

model Citizenship {
  id          String                     @id @default(uuid())
  name        String                     @unique
  favourite   Boolean                    @default(false)
  visaFree    VisaFree[]
  blacklisted Blacklisted[]
  surcharges  VisaCitizenshipSurcharge[]
  Client      Client[]
}

model Country {
  id                 String                     @id @default(uuid())
  name               String                     @unique
  eVisaAvailable     Boolean                    @default(false)
  multivisaAvailable Boolean                    @default(false)
  cities             City[]
  visaFree           VisaFree[]
  blacklisted        Blacklisted[]
  surcharges         VisaCitizenshipSurcharge[]
}

model City {
  id        String  @id @default(uuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  isActive  Boolean @default(true)
}

model VisaFree {
  citizenshipId String
  countryId     String
  stampDuration Int

  citizenship Citizenship @relation(fields: [citizenshipId], references: [id])
  country     Country     @relation(fields: [countryId], references: [id])

  @@id([citizenshipId, countryId])
}

model Blacklisted {
  citizenshipId String
  countryId     String

  citizenship Citizenship @relation(fields: [citizenshipId], references: [id])
  country     Country     @relation(fields: [countryId], references: [id])

  @@id([citizenshipId, countryId])
}

model VisaCitizenshipSurcharge {
  id              String  @id @default(uuid())
  citizenshipId   String
  countryId       String
  visaTypeId      String
  surchargeAmount Float
  note            String?

  citizenship Citizenship @relation(fields: [citizenshipId], references: [id])
  country     Country     @relation(fields: [countryId], references: [id])
  // visaType    VisaType    @relation(fields: [visaTypeId], references: [id])
}

model ExchangeRate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  rubToVnd  Float
  vndToRub  Float
  usdtToVnd Float
  vndToUsdt Float
  usdtToRub Float
  rubToUsdt Float
  userId    String
  createdBy User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TelegramChannel {
  id                String                @id @default(uuid())
  createdAt         DateTime              @default(now())
  chatId            String                @unique
  chatTitle         String
  chatUsername      String
  chatType          String
  fromId            String
  fromIsBot         Boolean
  fromFirstName     String
  fromLastName      String
  fromUsername      String
  status            TelegramChannelStatus @default(active)
  updatedAt         DateTime              @updatedAt
  messageTemplateId String?
  messageTemplate   MessageTemplate?      @relation(fields: [messageTemplateId], references: [id])
}

model MessageTemplate {
  id               String            @id @default(uuid())
  title            String
  body             String
  telegramChannels TelegramChannel[]
}

enum UserRole {
  client
  manager
  admin
}

enum TelegramChannelStatus {
  active
  blocked
  kicked
  insufficient_permissions
}

enum OrderStatus {
  draft
  submitted
  paid
  cancelled
}

enum ServiceType {
  visa
  visarun
}

enum DiscountAppliedType {
  manual
  rule
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  status    OrderStatus @default(draft)
  items     OrderItem[]
}

model OrderItem {
  id                  String               @id @default(uuid())
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id])
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id])
  serviceType         ServiceType
  serviceTypeId       String
  discountAppliedType DiscountAppliedType?
  discountRuleId      String?
  discountRule        ClientDiscountRule?  @relation(fields: [discountRuleId], references: [id])
  discountAmount      Float
  discountComment     String?
  note                String?
  basePrice           Float
  finalPrice          Float

  @@index([orderId])
  @@index([clientId])
  @@index([discountRuleId])
}

enum DiscountType {
  percent
  fixed
}

enum AppliesToService {
  visa
  visarun
  all
}

model ClientDiscountRule {
  id                   String           @id @default(uuid())
  name                 String
  discountType         DiscountType
  discountValue        Float
  appliesToService     AppliesToService
  appliesAutomatically Boolean
  validFrom            DateTime
  validTo              DateTime
  minOrders            Int
  isActive             Boolean
  note                 String?

  assignments ClientDiscountAssignment[]
  OrderItem   OrderItem[]
}

model ClientDiscountAssignment {
  id               String   @id @default(uuid())
  clientId         String
  ruleId           String
  assignedByUserId String
  assignedAt       DateTime
  note             String?

  client     Client             @relation(fields: [clientId], references: [id])
  rule       ClientDiscountRule @relation(fields: [ruleId], references: [id])
  assignedBy User               @relation(fields: [assignedByUserId], references: [id])

  @@index([clientId])
  @@index([ruleId])
  @@index([assignedByUserId])
}
